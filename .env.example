# --- Database ---
# Local dev uses SQLite. For staging/production switch the provider in
# prisma/schema.prisma to "postgresql" and point this at Postgres.
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Google Cloud Console > Credentials > OAuth client (Web application)
# Authorised redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe ---
# TEST keys until launch. sk_live_ keys move real money.
STRIPE_SECRET_KEY=""
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
#
# COMMA-SEPARATED. A Connect platform needs TWO deliveries at this one URL:
# a v2 "thin" event destination for the account capability events (v2 core
# events are rejected by classic webhook endpoints) and a snapshot one for the
# payment events. Each has its own signing secret; list both.
STRIPE_WEBHOOK_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Development shortcuts ---
# Set to 1 ONLY in local development to enable passwordless sign-in and
# simulated Stripe onboarding. The app refuses to boot in production if set.
LEER_DEV_LOGIN=""

# Cron sweep shared secret (Vercel sends it as an Authorization header)
CRON_SECRET=""
