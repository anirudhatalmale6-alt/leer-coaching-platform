// LEER - 1:1 video coaching platform
// M1 schema: identity, role elevation, Stripe Connect onboarding state.
//
// Provider note: SQLite is used for local development so the app runs with no
// external services. Switch `provider` to "postgresql" and point DATABASE_URL at
// a Postgres instance for staging/production - no model changes are required,
// nothing here uses a SQLite-only or Postgres-only type.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single human. Everyone signs up as a Trainee; `isTrainer` is flipped to
/// true by Stripe Connect onboarding completing, never by the user asking.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// Handle powering the public trainer URL (leersports.com/<username>).
  /// Null until the user becomes a trainer.
  username String? @unique

  /// THE role flag from the spec. Derived state - see lib/connect.ts.
  /// Only ever set from Stripe's own account status, so it cannot be spoofed
  /// by a client-side call.
  isTrainer        Boolean   @default(false)
  trainerActiveAt  DateTime?

  // --- Stripe Connect (Accounts v2, recipient configuration) ---
  stripeAccountId String? @unique
  /// Mirror of Stripe's account. Refreshed on return from onboarding and by the
  /// capability_status_updated webhook.
  /// Accounts v2: configuration.recipient.capabilities.stripe_balance
  /// .stripe_transfers.status. "active" is the only value that means money can
  /// actually reach this trainer - see lib/connect.ts.
  ///
  /// The v1 fields (details_submitted / charges_enabled / payouts_enabled) are
  /// deliberately gone: Stripe deprecated them for v2 accounts and reading them
  /// would silently report false for a perfectly healthy trainer.
  /// ISO country chosen at onboarding. Stripe fixes this at account
  /// creation, so it is recorded for support rather than re-derived.
  stripeCountry                 String?
  stripeTransfersStatus         String?
  /// `stripe_balance.payouts`. Reported to the trainer, never used to gate a
  /// booking - see ConnectStatus in lib/connect.ts.
  stripePayoutsStatus           String?
  stripeRequirementsOutstanding Boolean   @default(false)
  /// JSON from lib/connect-requirements.ts: what Stripe still wants, split
  /// into what BLOCKS the account and what it will merely want later. The two
  /// must not be conflated - see that file.
  stripeRequirements            String?
  stripeSyncedAt                DateTime?

  // --- Public profile (Phase 2 M1) ---

  /// One line under the name on the public card. Newlines are collapsed on the
  /// way in - see lib/profile.ts.
  bio String?

  /// One of lib/profile.ts CATEGORIES. Stored as text rather than an enum so
  /// the same schema runs on SQLite and Postgres, and so adding a sport later
  /// is not a migration.
  category String?

  /// Bare handles, never pasted URLs: the public page builds the link itself,
  /// so an "Instagram" icon cannot be pointed at another site.
  instagram String?
  youtube   String?

  /// R2 object key for the uploaded profile image. Null means fall back to the
  /// Google avatar in `image`, then to the initial.
  avatarKey String?

  /// The coaching pass. Price is in cents and is read from HERE at checkout -
  /// never from the browser.
  coachingPriceCents Int     @default(5000)
  coachingEnabled    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  portfolioLinks PortfolioLink[]

  traineeRooms CoachingRoom[] @relation("TraineeRooms")
  trainerRooms CoachingRoom[] @relation("TrainerRooms")

  @@index([isTrainer])
}

/// Up to five Reels/Shorts links on the trainer's public card.
///
/// A relation rather than a JSON blob so ordering is explicit and a link can be
/// indexed or counted without parsing every row.
model PortfolioLink {
  id       String @id @default(cuid())
  userId   String
  url      String
  /// 0-based display order. Unique per user so two links cannot claim a slot.
  position Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@index([userId])
}

// --- Auth.js (NextAuth) standard models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// One purchased coaching session: the escrow, the clip, and the feedback.
model CoachingRoom {
  id String @id @default(cuid())

  /// The unguessable URL segment: leersports.com/coaching/<publicId>.
  /// Separate from the primary key so the database id is never in a URL.
  publicId String @unique

  traineeId String
  trainerId String
  trainee   User   @relation("TraineeRooms", fields: [traineeId], references: [id])
  trainer   User   @relation("TrainerRooms", fields: [trainerId], references: [id])

  /// R2 object key of the clip the trainee uploaded.
  videoKey String

  /// Detected at upload, from the file's own sample entry - "hevc", "h264"...
  /// Recorded so the coach's room can explain a black screen instead of
  /// leaving them to guess, and so support can see it after the fact.
  videoCodec String?

  /// Money is stored in the smallest currency unit, as an integer. Never a
  /// float - 0.1 + 0.2 is not 0.3, and this is somebody's payout.
  priceCents Int
  currency   String @default("usd")

  /// See lib/escrow.ts for the state machine. Kept as a string rather than a
  /// native enum so the same schema runs on SQLite and Postgres unchanged.
  status String @default("awaiting_payment")

  /// The hosted Checkout Session the trainee pays through. Recorded at
  /// creation; the PaymentIntent below only exists once they actually pay, so
  /// this is the only handle on an abandoned booking.
  checkoutSessionId String? @unique

  /// Authorised at purchase, captured on delivery, cancelled on timeout.
  /// Filled in by the webhook, not at creation - Checkout mints the
  /// PaymentIntent itself when the trainee reaches the payment step.
  paymentIntentId String? @unique
  /// The 80% transfer to the trainer, created on approval.
  transferId String?
  /// Set if the authorisation was cancelled or the capture refunded.
  refundId String?

  /// 24 hours after the authorisation. The sweep cancels anything past this
  /// that has not been delivered.
  deliverDueAt DateTime?
  paidAt       DateTime?
  deliveredAt  DateTime?
  approvedAt   DateTime?
  closedAt     DateTime?

  /// Canvas marks, as produced by the analysis canvas.
  annotations String?

  /// "What do you want the trainer to focus on?" from the booking modal.
  /// Optional: a trainee who just wants a general look should not be blocked.
  focusNote String?

  /// Why the room ended, for support and for the trainee's own screen.
  closeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId, status])
  @@index([traineeId])
  /// The sweep queries exactly this pair, and it will be the hottest query on
  /// the platform once there is volume.
  @@index([status, deliverDueAt])
}

/// Every Stripe webhook we have already handled, so a redelivery is a no-op.
/// Stripe retries aggressively and will replay events; without this an
/// account.updated replay could re-run side effects.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
